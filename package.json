{
  "name": "yugang",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "鱼缸：基于 pi-durable 的 QQ 群「群员」，出口即能力",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "probe": "node --env-file-if-exists=.env scripts/probe.ts",
    "prompts": "node scripts/prompts.ts",
    "ops": "node --env-file-if-exists=.env scripts/ops.ts",
    "ping": "node --env-file-if-exists=.env scripts/ping.ts",
    "quota": "node --env-file-if-exists=.env scripts/quota.ts",
    "creds": "node scripts/creds.ts",
    "protocol": "node --env-file-if-exists=.env scripts/protocol.ts",
    "up": "node --env-file-if-exists=.env scripts/up.ts",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.ts",
    "down": "node --env-file-if-exists=.env scripts/down.ts",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.ts",
    "token": "node --env-file-if-exists=.env scripts/token.ts",
    "memes": "node --env-file-if-exists=.env scripts/memes.ts",
    "memory": "node --env-file-if-exists=.env scripts/memory.ts",
    "login": "node --env-file-if-exists=.env scripts/login.ts",
    "tts": "node --env-file-if-exists=.env scripts/tts.ts",
    "deps": "node --env-file-if-exists=.env scripts/deps.ts",
    "smoke:news": "node scripts/news-real-model-smoke.ts && node scripts/news-runtime-smoke.ts",
    "itbed": "node scripts/itbed/driver.ts --all",
    "itbed:all": "node scripts/itbed/driver.ts --all",
    "itbed:self-test": "node scripts/itbed/driver.ts --self-test",
    "itbed:smoke": "node scripts/itbed/launch.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "fast-xml-parser": "5.11.2",
    "https-proxy-agent": "9.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
