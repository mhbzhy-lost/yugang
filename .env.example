# 鱼缸的环境变量。复制成 .env 后填「必填」那五项，剩下的默认值一般够用。
# .env 已被 gitignore；不要把它提交，也不要把里面的值贴到任何地方。

# ───────────── 必填 ─────────────

# 协议端（NapCat / SnowLuma）的 OneBot v11 正向 WebSocket 地址
ONEBOT_WS_URL=ws://127.0.0.1:3001

# 协议端里设置的那个 token。别手写：跑 `npm run token` 生成一串随机的，
# 它会同时写进 .env 和 NapCat 的 onebot.json，两边保证一致
ONEBOT_TOKEN=

# 你的 QQ 号。私聊只认它；群里它不受作息/冷却/配额限制，也不用 @
MASTER_QQ=

# 允许鱼说话的群号，逗号分隔。留空 = 所有群都说话（不推荐）
GROUPS=

# 协议端里登录的鱼号（QQ 号）。npm run protocol start 用它无头拉起 QQ
PROTOCOL_QQ=

# ───────────── 通道（可选）─────────────
# 启用哪些通道（逗号分隔）：qq / dingtalk。缺省 qq（接 NapCat 的部署不用动）。
# none 或留空 = 不启动任何通道（无 QQ 的机器用这个，进程照常起、模型可用）。
# 未知名字启动即报错。钉钉协议待定，配了也只提示未启用。
# CHANNELS=none

# ───────────── 行为调参：请写 fish.config.json ─────────────
# 思考档、换页阈值、周报群、搭话参数全部只在 fish.config.json
# （模板见 fish.config.example，鱼自己有 read/edit 权限，可以自己调）。
# 不再认任何行为类 env 变量（2026-11-06 清理：THINKING_LEVEL / COMPACT_MAX_ENTRIES /
# COMPACT_MAX_CHARS / WEEKLY_GROUP_ID 的 env 兜底与旧限流变量 AMBIENT_CHANCE /
# COOLDOWN_MS / DAILY_QUOTA / QUIET_HOURS 等已全部删除，写了不生效）。

# ───────────── 协议端（可选）─────────────
# npm run up 时顺手拉起协议端；留空则假设你已经自己起好了。
# 例：PROTOCOL_CMD=bash ~/napcat/launcher.sh
# PROTOCOL_CMD=

# ───────────── 模型 ─────────────
# 模型选择只有一个入口：config/models.json 的 models 角色表（main / vision / image）。
# 没有模型相关环境变量，也没有启动参数；改完让鱼 restart 生效。
# 思考档位在 fish.config.json 的 thinkingLevel。

# ───────────── 生图（可选）─────────────
# provider 级代理不在这里：写 config/models.json 的 providers.<id>.proxy（见 AGENTS.md）
# Windows ComfyUI 的本机 SSH 隧道；仅接受 127.0.0.1 的 HTTP 地址，留空 = draw 不可用
COMFYUI_URL=http://127.0.0.1:18190
# 在线生图（gpt_image 工具）不需要额外 key：用 config/models.json 的 models.image.provider
# 指向的那条登录（npm run login）。两个工具互不兜底：draw 只画本地，gpt_image 只走在线
# 允许 bypass: 画图注入的群号（逗号分隔）；主人（MASTER_QQ）始终允许。留空 = 仅主人可用
# 例：BYPASS_GROUPS=123456789,987654321
BYPASS_GROUPS=

# ───────────── 外部信息源（可选）─────────────
# 60s 新闻服务（新闻播报数据源）的根地址覆盖。生产默认 http://127.0.0.1:4399（本机自建 Docker），
# 不必填写；IT bed 可把它指向本地 faux 60s 做联调。留空/未设即用生产默认。
# SIXTY_BASE_URL=http://127.0.0.1:4399
# 60s 容器/镜像（deploy 前置会自动 ensure；生产建议用 digest 固定镜像）
# SIXTY_CONTAINER=60s
# SIXTY_IMAGE=vikiboss/60s
# DOCKER_BIN=/usr/local/bin/docker
# B 站 API 根地址覆盖。生产无需填写（默认 https://api.bilibili.com）；IT bed 可把它指向本地
# faux B 站做联调。留空/未设即用生产默认。
# BILI_BASE_URL=https://api.bilibili.com

# ───────────── 路径（一般不用动）─────────────
# 仓库根：所有路径的唯一基准（数据、媒体、prompt、配置都从它派生）。
# 不填时按源码位置推导（src/paths.ts 的上一级），所以本地开发与 macmini 都不用填；
# 只有在「从别处启动进程 / 软链部署」这类特殊布局下才需要显式写死。
# YUGANG_ROOT=/绝对路径/yugang
# 数据目录（fish.db / chatlog / media / usage / sent.json）：缺省 <仓库根>/var，
# YUGANG_HOME 设置后整体搬走、完全胜出
# YUGANG_HOME=/绝对路径/var
# 下面三项缺省都从数据目录 / 仓库根派生，同样只在特殊布局时才需要
# MEDIA_ROOT=
# WORKSPACE_ROOT=
# PROMPT_ROOT=

# ───────────── 生图动图（可选）─────────────
# gpt_image 的 GIF 通道走 OpenAI 官方 API（Codex 订阅后端不开 GIF）。
# API key 放 config/auth.json 的 openai 条目（{"openai":{"type":"api_key","key":"sk-..."}}），
# 不要写在这里；下面只覆盖 API 根地址（代理/测试用），留空即 https://api.openai.com
# OPENAI_BASE_URL=https://api.openai.com

# ───────────── 看视频（可选）─────────────
# 抽帧用的 python（要装 PyAV）：留空默认 ~/tts/.venv-video/bin/python
# VIDEO_PYTHON=/Users/you/tts/.venv-video/bin/python

# ───────────── 语音（可选）─────────────
# 音色不再走 .env：已迁到 fish.config.json 的 voices（人格名 → { url, referWav, referText, referLanguage }）。
# 没在 voices 里配过的人格就是没有语音能力——不设兜底，防止 A 人格用 B 人格的声音说话。
