# 鱼缸的环境变量。复制成 .env 后填「必填」那四项，剩下的默认值一般够用。
# .env 已被 gitignore；不要把它提交，也不要把里面的值贴到任何地方。

# ───────────── 必填 ─────────────

# 协议端（NapCat / SnowLuma）的 OneBot v11 正向 WebSocket 地址
ONEBOT_WS_URL=ws://127.0.0.1:3001

# 协议端里设置的那个 token；没设就留空
ONEBOT_TOKEN=

# 你的 QQ 号。私聊只认它；群里它不受作息/冷却/配额限制，也不用 @
MASTER_QQ=

# 允许鱼说话的群号，逗号分隔。留空 = 所有群都说话（不推荐）
GROUPS=

# ───────────── 说话频率 ─────────────
# 非 @ 消息先按这个概率抽样，抽中才进打分。0 = 从不主动，1 = 每条都打分
AMBIENT_CHANCE=0.08
# 同一个群两次主动开口的最小间隔（毫秒）
COOLDOWN_MS=120000
# 每个群每天最多主动开口几轮（被 @ 不算）
DAILY_QUOTA=40
# 安静时段：几点到几点不说话（24 小时制）。留空 = 全天可说话
QUIET_HOURS=1-8

# ───────────── 协议端（可选）─────────────
# npm run up 时顺手拉起协议端；留空则假设你已经自己起好了。
# 例：PROTOCOL_CMD=bash ~/napcat/launcher.sh
# PROTOCOL_CMD=

# ───────────── 模型 ─────────────
# 默认用 config/models.json 里的 default；要换就取消注释
# MODEL_PROVIDER=qoder-pool
# MODEL_ID=DeepSeek-Flash
# 打分和写备忘用同一个模型就够了；想让它们更便宜就单独指定
# GATE_PROVIDER=
# GATE_MODEL_ID=

# ───────────── 路径（一般不用动）─────────────
# 数据库、原话簿、用量、媒体都放这里，用 YUGANG_HOME 可以整体搬走
# YUGANG_HOME=~/鱼缸/var
# MEDIA_ROOT=
# WORKSPACE_ROOT=
# PROMPT_ROOT=
# YUGANG_MODELS=config/models.json

# ───────────── 压缩 ─────────────
# 攒到多少条 / 多少字就换页
COMPACT_MAX_ENTRIES=80
COMPACT_MAX_CHARS=12000
