# 鱼缸的环境变量。复制成 .env 后填「必填」那五项，剩下的默认值一般够用。
# .env 已被 gitignore；不要把它提交，也不要把里面的值贴到任何地方。

# ───────────── 必填 ─────────────

# 协议端（NapCat / SnowLuma）的 OneBot v11 正向 WebSocket 地址
ONEBOT_WS_URL=ws://127.0.0.1:3001

# 协议端里设置的那个 token。别手写：跑 `npm run token` 生成一串随机的，
# 它会同时写进 .env 和 NapCat 的 onebot.json，两边保证一致
ONEBOT_TOKEN=

# 你的 QQ 号。私聊只认它；群里它不受作息/冷却/配额限制，也不用 @
MASTER_QQ=

# 允许鱼说话的群号，逗号分隔。留空 = 所有群都说话（不推荐）
GROUPS=

# 协议端里登录的鱼号（QQ 号）。npm run protocol start 用它无头拉起 QQ
PROTOCOL_QQ=

# ───────────── 说话频率 ─────────────
# 当前策略：鱼只应答 @（任何人都行）和主人，其余群消息一律不应答。
# 所以下面四个旧限流变量都不再参与判定；解析保留是为了兼容现有 .env，别删。

# 【仅兼容保留，当前策略下无效】原为非 @ 消息的抽样概率；现在非 @ 直接不应答，抽样已废除
AMBIENT_CHANCE=0.1
# 按群覆盖随机门（群号:值，逗号分隔）；未列出的群用上面全局值，0 = 该群只应答 @ 不回闲聊
# 例：AMBIENT_CHANCE_BY_GROUP=10001:0.15,10002:0
# AMBIENT_CHANCE_BY_GROUP=
# 非 @ 消息进入打分的概率（随机粗筛，0=非@全沉默，1=全部打分）
COOLDOWN_MS=120000
# 【仅兼容保留，当前策略下无效】原为每日主动开口配额；同上，配额已无处生效
DAILY_QUOTA=40
# 【仅兼容保留，当前策略下无效】原为安静时段；现在主人和 @ 都必答、非 @ 一律不应答，安静时段已无处生效
QUIET_HOURS=1-8

# ───────────── 协议端（可选）─────────────
# npm run up 时顺手拉起协议端；留空则假设你已经自己起好了。
# 例：PROTOCOL_CMD=bash ~/napcat/launcher.sh
# PROTOCOL_CMD=

# ───────────── 模型 ─────────────
# 默认用 config/models.json 里的 default；要换就取消注释
# 主模型：不填走 config/models.json 的 default（zai-coding-cn/glm-5.3-flash）
# 备选：deepseek/deepseek-flash（官方），qoder-pool/DeepSeek-Flash（代理池）
# MODEL_PROVIDER=deepseek
# MODEL_ID=deepseek-flash
# 打分和写备忘用同一个模型就够了；想让它们更便宜就单独指定
# GATE_PROVIDER=
# GATE_MODEL_ID=

# ───────────── 生图（可选）─────────────
# Windows 上 SD WebUI 的地址；留空 = 不启用本地画图（draw 工具）
SD_WEBUI_URL=http://<局域网IP>:7860
# ModelScope API-KEY（魔搭 modelscope.cn 控制台建的 SDK 令牌）；填了鱼才有 imggen 生图
MODELSCOPE_KEY=
# 允许 bypass: 画图注入的群号（逗号分隔）；主人（MASTER_QQ）始终允许。留空 = 仅主人可用
# 例：BYPASS_GROUPS=123456789,987654321
BYPASS_GROUPS=

# ───────────── 群周报（可选）─────────────
# 统计这个群的本周画像（发言量/话痨榜/时段）；每周日 21 点私聊发给主人，留空 = 不发
WEEKLY_GROUP_ID=

# ───────────── 路径（一般不用动）─────────────
# 数据库、原话簿、用量、媒体都放这里，用 YUGANG_HOME 可以整体搬走
# YUGANG_HOME=~/鱼缸/var
# MEDIA_ROOT=
# WORKSPACE_ROOT=
# PROMPT_ROOT=
# YUGANG_MODELS=config/models.json

# ───────────── 压缩 ─────────────
# 攒到多少条 / 多少字就换页
COMPACT_MAX_ENTRIES=80
COMPACT_MAX_CHARS=12000
