node_modules/
# 容器用的 Linux 依赖目录（bind mount 到 /app/node_modules）。
# 与上面 macOS 那份必须分开：sharp 等原生包的二进制跟平台绑定。
.node_modules-linux/
# 容器协议端数据（napcat 登录态与配置，含凭据，绝不入库）
/data/
/var/
*.log
.DS_Store
config/auth.json
# 凭据文件的跨进程锁与原子写临时文件（tmp 里是明文凭据，同样绝不入库）
config/auth.json.*
config/models.json
.env
.pi/
.trash/
.opencode/
# 模型配置与运行时行为配置都是每台机器一份；模板分别是 config/models.example.json 与 fish.config.example
fish.config.json

# 本机备份文件（含 .env / 配置副本，绝不入库）
*.bak
*.bak-*
.env.bak*

# 过程性计划/报告/交接文档不入库（保留 test/model-input-templates.test.ts 依赖的 docs/decisions/）
/docs/*
!/docs/decisions/

# 本地模型训练与实验脚本不入库
/scripts/regional-training/
