{
  "ambientMinIntervalSeconds": 30,
  "watchAmbientChance": 0.5,
  "engage": {
    "freeSeconds": 60,
    "freeBrowseChance": 0.03,
    "freeBatchMax": 50
  },
  "sendPacingSeconds": 6,
  "video": {
    "browseMaxViewsPerRound": 5,
    "dailyBudget": 60
  },
  "ammo": {
    "dailyBudget": 60
  },
  "news": {
    "at": "10:30",
    "targetGroup": "",
    "topics": [
      {
        "name": "AI",
        "sources": ["60s", "huxiu", "ithome", "zhihu_daily"],
        "keywords": ["AI", "人工智能", "大模型", "机器学习", "AIGC"],
        "exclude": []
      },
      {
        "name": "时政",
        "sources": ["people", "60s", "jiemian"],
        "keywords": ["时政", "国内", "国际", "外交", "政策"],
        "exclude": []
      },
      {
        "name": "军事",
        "sources": ["60s", "people", "weibo_hot"],
        "keywords": ["军事", "国防", "军演", "战机", "军舰"],
        "exclude": []
      },
      {
        "name": "科技数码",
        "sources": ["ithome", "huxiu", "zhihu_daily"],
        "keywords": ["科技", "数码", "手机", "芯片", "发布会"],
        "exclude": []
      },
      {
        "name": "趣闻二次元",
        "sources": ["weibo_hot", "baidu_hot", "zhihu_daily"],
        "keywords": ["趣闻", "热梗", "二次元", "动漫", "游戏"],
        "exclude": ["明星", "综艺", "出轨", "官宣恋情", "红毯", "颁奖礼", "八卦", "热搜第一"]
      }
    ],
    "perTopicInput": 20,
    "perTopicOutput": 5
  },
  "thinkingLevel": "low",
  "compact": {
    "maxEntries": 200,
    "maxChars": 50000
  },
  "weeklyGroupId": "",
  "memeCooldownMinutes": 8,
  "voices": {
    "爱莉希雅": {
      "url": "http://127.0.0.1:9880",
      "referWav": "/path/to/reference.wav",
      "referText": "参考音频对应原文",
      "referLanguage": "zh"
    }
  },
  "toolTimeoutSeconds": 30,
  "_engage": "注释：搭话参数（2026-11-06 合并：自由活动模式是唯一搭话机制，开窗两态已退役）。freeSeconds=自由拍长（秒，15–300，缺省 60）——多久进群看一眼，一拍把这段时间全部发送者的非 @ 消息合成一轮，在途时累积不并发；freeBrowseChance=空拍自主开口概率（0–1，缺省 0.03，宵禁内恒关）；freeBatchMax=单拍收集上限（条，1–200，缺省 50，超出丢最旧并计数进日志）；answerContextSize=@ 轮背景条数（1–100，可选）——不设=从已读标记补到锚点的全部未读（recent 30 条天然上限），设了=最近 N 条再剔已读。已读标记不受它影响：每次注入群消息的唤醒轮结束无条件推满到最新。有正在攒的 @ 组时本拍让行。逐字段校验，非法值告警保留缺省，热生效",
  "_sendPacingSeconds": "注释：出站配速（秒）——发送队列同会话相邻两次实际发送至少隔这么多秒，防连珠炮；0 = 关闭。对全部消息生效（@ 轮/环境轮/机械回执一样配速），改完下一拍生效。合法 0–60，非法告警保留缺省",
  "_video": "注释：会话自主浏览参数。browseMaxViewsPerRound=每个 browse 轮最多实际观看视频数（缺省 5）、dailyBudget=B 站每日请求总预算（缺省 60，跨重启持久计数）；主动门概率在 engage.freeBrowseChance（video.browseChance 已随开窗模式退役）。逐字段校验，非法值告警保留缺省，未知键告警，热生效",
  "_ammo": "注释：旧弹药管线已停用，源码仅作兼容保留。只有 dailyBudget 在 video.dailyBudget 缺失时回退使用；slots/browseMinutes/shareChance/ttlHours/maxPicksPerRun 等旧字段不再驱动 active 调度、工具或分享",
  "_news": "注释：新闻播报参数。at=每天播报时点（HH:MM）、targetGroup=播报目标群号（纯数字，空串 = 不启用；必须是 .env GROUPS 白名单内的群号，域校验在运行时播报编排处执行，config 工具改值时会提示）、topics=topic 表（每条只认 name/sources/keywords/exclude；sources 枚举 60s/jiemian/huxiu/ithome/people/zhihu_daily/weibo_hot/baidu_hot；显式给 topics 就整体覆盖缺省五 topic：AI/时政/军事/科技数码/趣闻二次元，趣闻二次元自带娱乐圈 exclude 词表，词表可热改）、perTopicInput=每 topic 送模型输入上限（条）、perTopicOutput=每 topic 输出上限（条）。逐字段校验，非法值告警保留缺省，未知键告警，热生效",
  "_salvagePlainReply": "注释：模型忘调 say 时的正文兜底，仅必答轮（私聊/被@）生效——零 say 时取正文首行补发（不截字数，出口链路无硬上限，长度约束只在 prompt 建议）；回复合集/回复鱼都不构成必答（看合集得 @），不触发本兜底；误发可把下面的键改成 false 关掉",
  "salvagePlainReply": true
}
